{
  "name": "Python Job Alert — Suraj",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 24 }]
        },
        "triggerAtHour": 9
      },
      "name": "1. Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 60]
    },
    {
      "parameters": {
        "url": "https://jsearch.p.rapidapi.com/search",
        "method": "GET",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "query", "value": "Python Developer India" },
            { "name": "page", "value": "1" },
            { "name": "num_pages", "value": "1" },
            { "name": "date_posted", "value": "today" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-RapidAPI-Key", "value": "YOUR_RAPIDAPI_KEY_HERE" },
            { "name": "X-RapidAPI-Host", "value": "jsearch.p.rapidapi.com" }
          ]
        }
      },
      "name": "2. Fetch Python Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [240, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "combineConditions": "OR" },
          "conditions": [
            {
              "leftValue": "={{ $json.job_city }}",
              "operator": { "type": "string", "operation": "contains" },
              "rightValue": "Noida"
            },
            {
              "leftValue": "={{ $json.job_city }}",
              "operator": { "type": "string", "operation": "contains" },
              "rightValue": "Hyderabad"
            },
            {
              "leftValue": "={{ $json.job_city }}",
              "operator": { "type": "string", "operation": "contains" },
              "rightValue": "Bengaluru"
            },
            {
              "leftValue": "={{ $json.job_is_remote }}",
              "operator": { "type": "boolean", "operation": "true" }
            }
          ]
        }
      },
      "name": "3. Filter by Location",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [240, 340]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $items().length }}",
              "operator": { "type": "number", "operation": "gt" },
              "rightValue": 0
            }
          ]
        }
      },
      "name": "4. New Jobs Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 480]
    },
    {
      "parameters": {
        "documentId": { "value": "YOUR_GOOGLE_SHEET_ID_HERE" },
        "sheetName": { "value": "Job Tracker" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ new Date().toLocaleDateString() }}",
            "Job Title": "={{ $json.job_title }}",
            "Company": "={{ $json.employer_name }}",
            "Location": "={{ $json.job_city }}, {{ $json.job_country }}",
            "Remote": "={{ $json.job_is_remote ? 'Yes' : 'No' }}",
            "Apply Link": "={{ $json.job_apply_link }}",
            "Salary": "={{ $json.job_min_salary ? $json.job_min_salary + ' - ' + $json.job_max_salary : 'Not listed' }}",
            "Posted": "={{ $json.job_posted_at_datetime_utc }}"
          }
        },
        "options": {}
      },
      "name": "5. Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [60, 620]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const jobs = $input.all();\n\nlet emailBody = `<h2>Python Developer Jobs — ${new Date().toDateString()}</h2>`;\nlet whatsappText = `*Python Jobs Today — ${new Date().toDateString()}*\\n\\n`;\n\njobs.forEach((job, i) => {\n  const j = job.json;\n  const title = j.job_title || 'N/A';\n  const company = j.employer_name || 'N/A';\n  const city = j.job_city || (j.job_is_remote ? 'Remote' : 'N/A');\n  const link = j.job_apply_link || '#';\n  const salary = j.job_min_salary ? `₹${j.job_min_salary} - ₹${j.job_max_salary}` : 'Salary not listed';\n\n  emailBody += `\n    <div style='margin-bottom:16px;padding:12px;border:1px solid #eee;border-radius:8px'>\n      <strong>${i + 1}. ${title}</strong><br/>\n      Company: ${company}<br/>\n      Location: ${city}<br/>\n      Salary: ${salary}<br/>\n      <a href='${link}'>Apply Now</a>\n    </div>`;\n\n  whatsappText += `*${i + 1}. ${title}*\\n`;\n  whatsappText += `Company: ${company}\\n`;\n  whatsappText += `Location: ${city}\\n`;\n  whatsappText += `${link}\\n\\n`;\n});\n\nreturn [{ json: { emailBody, whatsappText, jobCount: jobs.length } }];"
      },
      "name": "6. Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 760]
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@gmail.com",
        "subject": "=Python Jobs Today — {{ $json.jobCount }} new listings found!",
        "message": "={{ $json.emailBody }}",
        "options": { "appendAttribution": false }
      },
      "name": "7a. Send Gmail Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [-120, 900]
    },
    {
      "parameters": {
        "from": "whatsapp:+YOUR_TWILIO_NUMBER",
        "to": "whatsapp:+91YOUR_PHONE_NUMBER",
        "message": "={{ $json.whatsappText }}"
      },
      "name": "7b. Send WhatsApp (Twilio)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [240, 900]
    }
  ],
  "connections": {
    "1. Schedule Trigger": {
      "main": [[{ "node": "2. Fetch Python Jobs", "type": "main", "index": 0 }]]
    },
    "2. Fetch Python Jobs": {
      "main": [[{ "node": "3. Filter by Location", "type": "main", "index": 0 }]]
    },
    "3. Filter by Location": {
      "main": [[{ "node": "4. New Jobs Found?", "type": "main", "index": 0 }]]
    },
    "4. New Jobs Found?": {
      "main": [
        [{ "node": "5. Save to Google Sheets", "type": "main", "index": 0 }],
        []
      ]
    },
    "5. Save to Google Sheets": {
      "main": [[{ "node": "6. Format Message", "type": "main", "index": 0 }]]
    },
    "6. Format Message": {
      "main": [
        [
          { "node": "7a. Send Gmail Alert", "type": "main", "index": 0 },
          { "node": "7b. Send WhatsApp (Twilio)", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
