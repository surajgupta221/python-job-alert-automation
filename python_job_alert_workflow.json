    {
      "parameters": {
        "jsCode": "const jobs = $input.all();\n\nlet emailBody = `<h2>Python Developer Jobs — ${new Date().toDateString()}</h2>`;\nlet telegramText = `*🐍 Python Jobs Today — ${new Date().toDateString()}*\\n\\n`;\n\njobs.forEach((job, i) => {\n  const title = job.json[\"Job \"] || 'N/A';\n  const company = job.json[\"Company\"] || 'N/A';\n  const city = job.json[\"Location\"] || 'Remote';\n  const remote = job.json[\"Remote\"] || 'No';\n  const link = job.json[\"Apply Link\"] || '#';\n  const salary = job.json[\"Salary\"] || 'Not listed';\n\n  emailBody += `\n    <div style='margin-bottom:16px;padding:12px;border:1px solid #eee;border-radius:8px'>\n      <strong>${i + 1}. ${title}</strong><br/>\n      🏢 Company: ${company}<br/>\n      📍 Location: ${city}<br/>\n      🏠 Remote: ${remote}<br/>\n      💰 Salary: ${salary}<br/>\n      <a href='${link}'>✅ Apply Now</a>\n    </div>`;\n\n  telegramText += `*${i + 1}. ${title}*\\n`;\n  telegramText += `🏢 ${company}\\n`;\n  telegramText += `📍 ${city}\\n`;\n  telegramText += `🔗 ${link}\\n\\n`;\n});\n\nreturn [{ json: { emailBody, telegramText, jobCount: jobs.length } }];"
      },
